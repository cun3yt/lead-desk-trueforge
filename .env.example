# Local secrets — gitignored. Fill in values; never commit.

# Model provider. At least one key is required; trueforge/setup.sh registers every provider that has a key.
# The agent manifest (trueforge/agent.json) defaults to anthropic/claude-sonnet-5. To run on OpenAI, change
# "model": {"name": "openai/gpt-5.5"} there before running setup.sh.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ambiguous agent API key (ak_…), used as the MCP connector header and by trueforge/reset.sh and wipe.sh
AMBI_API_TOKEN=
AMBI_API_URL=https://app.ambiguous.ai
